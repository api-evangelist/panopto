{
  "opencollection": "1.0.0",
  "info": {
    "name": "Panopto Public Accessibility Tags API",
    "version": "1"
  },
  "items": [
    {
      "info": {
        "name": "Tags",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a paged list of tags.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/tags",
            "params": [
              {
                "name": "sortField",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortOrder",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageNumber",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "To fetch all elements, this endpoint can be called multiple times, starting at pageNumber = 0 and incrementing the page number until no results are returned."
        },
        {
          "info": {
            "name": "Create a new tag.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/tags"
          },
          "docs": "Create a new tag with the provided content."
        },
        {
          "info": {
            "name": "Get a tag by ID.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/tags/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a tag by ID."
        },
        {
          "info": {
            "name": "Update a tag.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/v1/tags/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update the tag's content."
        },
        {
          "info": {
            "name": "Delete a tag.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/tags/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete the tag with the given ID."
        },
        {
          "info": {
            "name": "Merge one or more tags into the tag represented by {id}.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/tags/:id/merge",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "This will delete the merged tags and update videos to reference the tag represented by {id}."
        }
      ]
    }
  ],
  "bundled": true
}